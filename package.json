{
  "name": "dsh-workspace-insight",
  "version": "0.2.1",
  "description": "Workspace and session activity dashboard for the DSH Web UI: see which workspaces are alive, which sessions they ran, and which ones to archive.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-workspace-insight contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "sessions",
    "dashboard",
    "heatmap",
    "activity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stone-beka/dsh-workspace-insight"
  },
  "bugs": {
    "url": "https://github.com/stone-beka/dsh-workspace-insight/issues"
  },
  "homepage": "https://github.com/stone-beka/dsh-workspace-insight#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
